# Copy to .env (never commit .env). All values are OPTIONAL and nothing in the current build
# reads them — the app runs fully offline with device-local persistence. They are reserved for
# the future backend, analytics and crash-reporting integrations (docs/backend-roadmap.md).
#
# EXPO_PUBLIC_* values are embedded in the app bundle and are visible to anyone with the app.
# Only ever put PUBLIC client keys here. NEVER put a Supabase service-role / secret key in any
# client file.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_SENTRY_DSN=
