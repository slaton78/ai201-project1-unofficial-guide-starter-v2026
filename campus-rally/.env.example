# Copy to .env (never commit .env). All values are OPTIONAL — the prototype runs fully offline
# with local persistence and no-op analytics/error reporting when these are blank.
#
# EXPO_PUBLIC_* values are embedded in the app bundle and are visible to anyone with the app.
# Only ever put PUBLIC client keys here. NEVER put a Supabase service-role / secret key in the
# client — the app refuses to use one if it detects it.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_SENTRY_DSN=
